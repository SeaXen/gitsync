#!/usr/bin/env bash
# gitsync — entry point. Resolves the install directory and runs the package.
set -euo pipefail

# resolve symlinks to find the real install dir
SELF="${BASH_SOURCE[0]}"
while [ -h "$SELF" ]; do
    DIR="$(cd -P "$(dirname "$SELF")" && pwd)"
    SELF="$(readlink "$SELF")"
    [[ $SELF != /* ]] && SELF="$DIR/$SELF"
done
APP_DIR="$(cd -P "$(dirname "$SELF")/.." && pwd)"

export PYTHONPATH="$APP_DIR${PYTHONPATH:+:$PYTHONPATH}"
export GITSYNC_HOME="${GITSYNC_HOME:-$APP_DIR}"

exec python3 -m gitsync "$@"
